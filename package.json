{
  "name": "shizukubot-web",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:test": "tsc --noEmit && vite build --mode test --configLoader runner",
    "check:public": "node --experimental-strip-types scripts/public-check.ts",
    "test": "node --experimental-strip-types --test src/core.test.ts src/file-info.test.ts src/inventory.test.ts src/developer.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/adb-credential-web": "2.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "@types/node": "22.19.0"
  }
}
